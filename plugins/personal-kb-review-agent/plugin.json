{
  "id": "personal-kb-review-agent",
  "name": "知识复盘智能体",
  "version": "1.0.0",
  "type": "backend_agent",
  "bind_ui_plugin_id": "demo-ui-think-visualizer",
  "description": "知识库复盘助手：对用户上传的知识库文档进行内容总结、要点复盘、知识问答（总结/复盘/提炼/问答用户私有文档资料时选用）",
  "author": "nvwa-agent",
  "dependencies": [
    "kb-retrieval-tool"
  ],
  "priority": 50,
  "private_tool_ids": [],
  "model_params": {
    "temperature": 0.3,
    "max_tokens": 2048
  },
  "lifecycle": {
    "on_load": "./main.py::on_load",
    "on_activate": "./main.py::on_activate",
    "on_deactivate": "./main.py::on_deactivate",
    "on_unload": "./main.py::on_unload"
  }
}
