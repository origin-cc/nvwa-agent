{
  "id": "personal-writing-agent",
  "name": "文档写作智能体",
  "version": "1.0.0",
  "type": "backend_agent",
  "bind_ui_plugin_id": "demo-ui-think-visualizer",
  "description": "文档写作助手：文章生成、文案撰写、润色改写、格式排版（写邮件/写文章/润色/改写/排版时选用）",
  "author": "nvwa-agent",
  "dependencies": [],
  "priority": 50,
  "private_tool_ids": [],
  "model_params": {
    "temperature": 0.8,
    "max_tokens": 4096
  },
  "lifecycle": {
    "on_load": "./main.py::on_load",
    "on_activate": "./main.py::on_activate",
    "on_deactivate": "./main.py::on_deactivate",
    "on_unload": "./main.py::on_unload"
  }
}
